            "state" : "translated",
            "value" : "Take photos of finished work and job details to attach to your jobs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma fotos del trabajo terminado y de los detalles para agregarlas a tus trabajos."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is shared once when you check in at a job, to confirm you arrived. You can still check in without it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación se comparte una vez cuando registras tu llegada a un trabajo, para confirmar que llegaste. También puedes registrarla sin compartirla."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
